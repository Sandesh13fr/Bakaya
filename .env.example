# Optional model extraction sends uploaded text to OpenAI. Off by default.
BAKAYA_ENABLE_LLM=false
OPENAI_API_KEY=
BAKAYA_OPENAI_MODEL=gpt-4o-mini
# Optional trusted reverse-proxy hostname(s), comma separated. No wildcards.
BAKAYA_ALLOWED_HOSTS=

# Optional Crustdata buyer enrichment; never commit the real key.
CRUSTDATA_API_KEY=
